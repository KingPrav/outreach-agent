# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env holds real secrets. It's in .gitignore, so it's never committed.

# --- OpenAI: shortlists people, summarizes research, drafts and checks messages ---
# https://platform.openai.com/api-keys  (needs API credits, separate from ChatGPT Plus)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Hunter.io: finds recruiters / engineering managers and their emails ---
# https://hunter.io/api-keys  (free plan has a small monthly credit allowance)
HUNTER_API_KEY=your-hunter-key-here

# --- Tavily: web search for researching each person and the role ---
# https://app.tavily.com  (free plan available)
TAVILY_API_KEY=tvly-your-tavily-key-here

# --- Your settings ---
# Path to your resume (PDF or Markdown), relative to this folder.
RESUME_PATH=profile/resume.pdf
# Most people to research and draft messages for, per company.
MAX_PEOPLE=6
